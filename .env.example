# Nome exibido no app
VITE_APP_NAME=SmartFood

# URL pública deste frontend (usado em links internos)
VITE_APP_URL=http://localhost:5173

# API NestJS (com prefixo /api) — use URL ABSOLUTA com https:// em produção
# Errado:  smartfood.api.brunoholanda.com/api  (vira path relativo no browser)
# Certo:   https://smartfood.api.brunoholanda.com/api
VITE_API_BASE_URL=http://localhost:3000/api

# Origem dos arquivos/uploads (sem /api) — também absoluta em produção
VITE_UPLOADS_BASE_URL=http://localhost:3000

# WebSocket da cozinha (mesmo host do backend) — absoluta em produção
VITE_SOCKET_URL=http://localhost:3000

# Alvo do proxy do Vite em desenvolvimento
VITE_DEV_PROXY_TARGET=http://localhost:3000
